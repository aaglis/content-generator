# ===== Viral Content Factory — Docker DB =====
# Copie para .env e ajuste conforme necessário. .env NUNCA é versionado.

# Porta exposta no host
POSTGRES_PORT=5433

# Credenciais do banco
POSTGRES_USER=vcf
POSTGRES_PASSWORD=vcf
POSTGRES_DB=viral_content_factory

# DATABASE_URL para usar no backend (Prisma ou outro ORM)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://vcf:vcf@localhost:5433/viral_content_factory
